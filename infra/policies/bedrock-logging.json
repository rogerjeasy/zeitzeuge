{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DeliverInvocationLogs",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": "arn:aws:logs:${region}:${account_id}:log-group:/aws/bedrock/${project}-${env}/invocations:*"
    }
  ]
}
