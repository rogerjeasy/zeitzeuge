{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "EcrAuth",
      "Effect": "Allow",
      "Action": "ecr:GetAuthorizationToken",
      "Resource": "*"
    },
    {
      "Sid": "PullInferenceImages",
      "Effect": "Allow",
      "Action": [
        "ecr:BatchGetImage",
        "ecr:GetDownloadUrlForLayer",
        "ecr:BatchCheckLayerAvailability"
      ],
      "Resource": "arn:aws:ecr:${region}:${account_id}:repository/${project}/*"
    },
    {
      "Sid": "ReadModelArtefactsAndDemCache",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::${project}-${env}-derivatives",
        "arn:aws:s3:::${project}-${env}-derivatives/*",
        "arn:aws:s3:::${project}-${env}-dem-cache",
        "arn:aws:s3:::${project}-${env}-dem-cache/*"
      ]
    },
    {
      "Sid": "OwnLogGroups",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:CreateLogStream",
        "logs:PutLogEvents",
        "logs:DescribeLogStreams"
      ],
      "Resource": "arn:aws:logs:${region}:${account_id}:log-group:/aws/sagemaker/Endpoints/${project}-${env}-*:*"
    },
    {
      "Sid": "EndpointMetrics",
      "Effect": "Allow",
      "Action": "cloudwatch:PutMetricData",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "cloudwatch:namespace": "/aws/sagemaker/Endpoints"
        }
      }
    },
    {
      "Sid": "ProjectKeysOnly",
      "Effect": "Allow",
      "Action": [
        "kms:Decrypt"
      ],
      "Resource": "arn:aws:kms:${region}:${account_id}:key/*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/Project": "${project}",
          "aws:ResourceTag/Env": "${env}"
        }
      }
    }
  ]
}
