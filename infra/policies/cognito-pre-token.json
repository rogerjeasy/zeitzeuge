{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "OwnLogGroup",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": "arn:aws:logs:${region}:${account_id}:log-group:/aws/lambda/${project}-${env}-cognito-pre-token:*"
    }
  ]
}
