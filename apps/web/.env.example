# ZEITZEUGE web — local development. Copy to `.env.local`.
#
# Server-side only (no NEXT_PUBLIC_ prefix): the browser never talks to the
# API for authentication — server actions do, and keep the tokens in HttpOnly
# cookies. In AWS the task definition sets this to the internal ALB
# (infra/modules/compute-api).
API_INTERNAL_URL=http://localhost:8000/api/v1
