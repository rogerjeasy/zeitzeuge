# ZEITZEUGE API — local development.
#
# Copy to `.env`. Every value here is either a literal for local work or a
# *reference* (`secretsmanager://…`, `ssm://…`) resolved at startup. In dev and
# prod these come from the ECS task definition, which is written by Terraform
# and contains no secret material at all.

ZZ_ENV=local
ZZ_REGION=eu-central-2
ZZ_LOG_LEVEL=DEBUG
ZZ_CORS_ORIGINS=http://localhost:3000

# --- Cognito (infra/modules/auth) -------------------------------------------
ZZ_COGNITO_USER_POOL_ID=eu-central-2_XXXXXXXXX
ZZ_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
# In AWS: ZZ_COGNITO_CLIENT_SECRET_REF=secretsmanager://arn:aws:secretsmanager:eu-central-2:…:secret:zeitzeuge/prod/cognito/web-…#client_secret
ZZ_COGNITO_CLIENT_SECRET_REF=
ZZ_GUEST_USERNAME=demo@zeitzeuge.ch
ZZ_GUEST_PASSWORD_REF=

# --- Database ----------------------------------------------------------------
# Local: a literal DSN. In AWS: leave it empty and set ZZ_DATABASE_SECRET_REF
# to the Aurora-managed secret, which rotates without a redeploy.
ZZ_DATABASE_DSN=postgresql+asyncpg://zeitzeuge:zeitzeuge@localhost:5432/zeitzeuge
ZZ_DATABASE_SECRET_REF=
ZZ_DATABASE_HOST=
ZZ_DATABASE_NAME=zeitzeuge

# --- Storage (infra/modules/storage) ----------------------------------------
ZZ_ASSETS_BUCKET=zeitzeuge-prod-assets
ZZ_ASSETS_KMS_KEY_ID=
ZZ_AVATAR_MAX_BYTES=5242880

# --- Key-value (infra/modules/keyvalue) -------------------------------------
ZZ_RATE_LIMIT_TABLE=zeitzeuge-prod-rate-limit

# --- Local AWS emulation -----------------------------------------------------
# `make up` starts moto on 5001. Never set this outside local development.
ZZ_AWS_ENDPOINT_URL=http://localhost:5001
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local
AWS_DEFAULT_REGION=eu-central-2
